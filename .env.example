# Copy this file to .env and replace every change-me value.

POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me-postgres-password

APP_DB_NAME=agreement_intelligence
APP_DB_USER=agreement_app
APP_DB_PASSWORD=change-me-application-database-password

KEYCLOAK_PORT=8080
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-database-password
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=local-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak-admin-password
KEYCLOAK_REALM=agreement-intelligence
OIDC_CLIENT_ID=agreement-intelligence-web
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_ISSUER=http://localhost:8080/realms/agreement-intelligence
OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/agreement-intelligence
# Deterministic local tenancy used only by the containerized demonstration stack.
API_ORGANIZATION_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
API_WORKSPACE_ID=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
WEB_PUBLIC_ORIGIN=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-application-session-secret

DEMO_REVIEWER_USERNAME=legal.reviewer
DEMO_REVIEWER_SUBJECT=cccccccc-cccc-4ccc-8ccc-cccccccccccc
DEMO_REVIEWER_EMAIL=legal.reviewer@example.test
DEMO_REVIEWER_FIRST_NAME=Legal
DEMO_REVIEWER_LAST_NAME=Reviewer
DEMO_REVIEWER_PASSWORD=change-me-reviewer-password
DEMO_ADMIN_USERNAME=platform.admin
DEMO_ADMIN_EMAIL=platform.admin@example.test
DEMO_ADMIN_FIRST_NAME=Platform
DEMO_ADMIN_LAST_NAME=Administrator
DEMO_ADMIN_PASSWORD=change-me-admin-password
DEMO_BUSINESS_APPROVER_USERNAME=business.approver
DEMO_BUSINESS_APPROVER_SUBJECT=eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee
DEMO_BUSINESS_APPROVER_EMAIL=business.approver@example.test
DEMO_BUSINESS_APPROVER_FIRST_NAME=Business
DEMO_BUSINESS_APPROVER_LAST_NAME=Approver
DEMO_BUSINESS_APPROVER_PASSWORD=change-me-business-approver-password

LOCALSTACK_PORT=4566
REDIS_PORT=6379
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
LANGFUSE_OTLP_ENDPOINT=
LANGFUSE_PORT=3001
# Optional local Langfuse profile. Keep these values local and uncommitted.
LANGFUSE_OTLP_AUTH=change-me-base64-public-key-colon-secret-key
LANGFUSE_POSTGRES_PASSWORD=change-me-langfuse-postgres-password
LANGFUSE_REDIS_PASSWORD=change-me-langfuse-redis-password
LANGFUSE_CLICKHOUSE_PASSWORD=change-me-langfuse-clickhouse-password
LANGFUSE_MINIO_PASSWORD=change-me-langfuse-minio-password
LANGFUSE_NEXTAUTH_SECRET=change-me-langfuse-nextauth-secret
LANGFUSE_SALT=change-me-langfuse-salt
LANGFUSE_ENCRYPTION_KEY=change-me-64-hex-characters
# Retention values are policy metadata for downstream storage configuration.
# Immutable business audit records are not automatically deleted.
AUDIT_RETENTION_DAYS=2555
TELEMETRY_RETENTION_DAYS=30
APPLICATION_LOG_RETENTION_DAYS=14
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_DOCUMENT_BUCKET=agreement-intelligence-documents
SQS_PROCESSING_QUEUE=agreement-intelligence-agreement-processing
SQS_PROCESSING_DLQ=agreement-intelligence-agreement-processing-dlq
SQS_EXPORT_QUEUE=agreement-intelligence-exports
SQS_EXPORT_DLQ=agreement-intelligence-exports-dlq
SQS_NOTIFICATION_QUEUE=agreement-intelligence-notifications
SQS_NOTIFICATION_DLQ=agreement-intelligence-notifications-dlq

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Monthly tenant budget reservations fail closed before expensive operations.
AI_MONTHLY_TOKEN_BUDGET=1000000
AI_MONTHLY_COST_BUDGET_USD=25
# Retrieval embeddings are configured independently from generation. The worker
# safely preserves lexical-only search when no provider key is configured.
EMBEDDING_MODEL=text-embedding-3-small
# Used only after an openai-compatible embedding endpoint is unavailable.
# Defaults to EMBEDDING_MODEL; it never inherits the generation-model fallback.
EMBEDDING_FALLBACK_MODEL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_INDEX_VERSION=embedding-v1
EMBEDDING_CONFIG_VERSION=embedding-gateway.v1
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=2
EMBEDDING_INPUT_COST_PER_MILLION_TOKENS=0.02
# `openai` is the default. Set `openai-compatible` only when starting the
# optional local-model profile below. Do not point this at a public endpoint.
MODEL_GATEWAY_MODE=openai
MODEL_GATEWAY_MODEL=
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_CONFIG_VERSION=model-gateway.v1
# Optional generation pricing used for safe cost telemetry and tenant usage
# settlement. These values are operator configuration, not billing truth; leave
# them blank when the selected model or endpoint has no maintained price.
MODEL_GATEWAY_INPUT_COST_PER_MILLION_TOKENS=
MODEL_GATEWAY_OUTPUT_COST_PER_MILLION_TOKENS=
# Set to `openai` only to use the hosted provider after a compatible endpoint
# is unavailable. It reuses OPENAI_API_KEY and never exposes it in artifacts.
MODEL_GATEWAY_FALLBACK_MODE=
MODEL_GATEWAY_FALLBACK_MODEL=

# Optional llama.cpp profile. Supply an existing local directory and GGUF
# filename; the stack does not download or commit model weights.
LLAMA_CPP_MODEL_DIR=
LLAMA_CPP_GGUF_FILE=
LLAMA_CPP_PORT=8081

WEB_PORT=3000
API_PORT=8000
MCP_PORT=8001
